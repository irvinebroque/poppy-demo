{
  "name": "poppy-workers-demo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "workers/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "types": "node scripts/cf.mjs workers types --include-runtime false",
    "check": "vp check --deny-warnings",
    "test": "vp test run",
    "build": "vp run build:ui && node scripts/cf.mjs deploy --dry-run",
    "deploy": "vp run build:ui && node scripts/deploy.mjs",
    "postinstall": "node scripts/prepare-guac.mjs --optional && node scripts/cf.mjs",
    "smoke:live": "node tests/live-smoke.mjs",
    "build:ui": "vp build",
    "prepare": "vp config --no-agent",
    "lint": "vp lint --deny-warnings",
    "fmt": "vp fmt",
    "build:guac": "node scripts/build-guac.mjs",
    "test:mole": "node scripts/prepare-guac.mjs --require && vp test run tests/private-search.test.mjs",
    "browse:private": "node scripts/browse-private.mjs"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-durable": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^2.0.0",
    "agents": "^0.28.0",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.28",
    "miniflare": "5.20261104.0-beta",
    "playwright": "^1.65.0",
    "tailwindcss": "^4.3.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  },
  "engines": {
    "node": "^22.23.0 || ^24.22.0 || >=26.12.0"
  },
  "packageManager": "npm@11.20.0"
}
