{
  "name": "poppy-workers-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "types": "node scripts/cf.mjs workers types --include-runtime false",
    "check": "tsc --noEmit && tsc -p workers/caller/client/tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "build": "node scripts/cf.mjs deploy --dry-run",
    "deploy": "node scripts/deploy.mjs",
    "postinstall": "node scripts/cf.mjs",
    "smoke:live": "node tests/live-smoke.mjs",
    "build:ui": "vite build --config workers/caller/vite.config.ts"
  },
  "dependencies": {
    "@cloudflare/kumo": "^2.14.0",
    "@earendil-works/pi-ai": "^1.1.0",
    "@earendil-works/pi-durable": "^1.1.0",
    "@phosphor-icons/react": "^2.1.10",
    "@streamdown/code": "^2.0.0",
    "agents": "^0.28.1",
    "jose": "^6.2.12",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "streamdown": "^2.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cf": "^1.0.0-beta.14",
    "esbuild": "^0.28.2",
    "miniflare": "5.20261006.1-alpha",
    "tailwindcss": "^4.3.3",
    "typescript": "latest",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  },
  "overrides": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1"
  },
  "workspaces": [
    "workers/*"
  ]
}
